{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GamePilot",
  "version": "2.1.0",
  "identifier": "com.gamepilot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GamePilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "GamePilot Overlay",
        "url": "/overlay.html",
        "width": 400,
        "height": 600,
        "x": 50,
        "y": 50,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.modrinth.com https://cdn.modrinth.com https://github.com https://api.github.com https://127.0.0.1:2999; img-src 'self' https://cdn.modrinth.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0OTZFNEI2QzRBNUE1OTQKUldTVXBhWEV0dVNXbEdFaXlpU2pCa0NROUh4SklzZkQzenlzWktzZEVpTUl4VEZlbTFEZ2hRWUwK",
      "endpoints": [
        "https://github.com/penguarjol/GamePilot/releases/latest/download/latest.json"
      ]
    }
  }
}